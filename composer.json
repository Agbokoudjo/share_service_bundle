{
    "name": "wlindabla/share-service-bundle",
    "description": "Reusable cross-project Symfony services: ID encryption, token/password generation & hashing, browser/bot request validation, async method dispatch over Messenger, identity similarity detection, form violation extraction, and a thin Serializer facade.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "security",
        "encryption",
        "messenger",
        "token",
        "password",
        "similarity"
    ],
    "authors": [
        {
            "name": "AGBOKOUDJO Franck",
            "email": "internationaleswebservices@gmail.com",
            "homepage": "https://github.com/Agbokoudjo/"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-sodium": "*",
        "ext-mbstring": "*",
        "psr/container": "^1.1|^2.0",
        "psr/log": "^2.0|^3.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher-contracts": "^2.5|^3.0",
        "symfony/messenger": "^6.4|^7.0|^8.0",
        "symfony/form": "^6.4|^7.0|^8.0",
        "symfony/translation-contracts": "^2.5|^3.0",
        "symfony/serializer": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/phpunit-bridge": "^6.4|^7.0",
        "friendsofphp/php-cs-fixer": "^3.55",
        "phpstan/phpstan": "^1.11",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Wlindabla\\ShareServiceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wlindabla\\ShareServiceBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
